EXPO_PUBLIC_DATA_SOURCE=mock
EXPO_PUBLIC_API_BASE_URL=
# Native OIDC configuration (issuer and client ID are public values).
# HTTP builds need a WCSD backend/BFF with authorization and browser cookie
# sessions before using real data. Never put API keys, client secrets, or
# vendor credentials in EXPO_PUBLIC_* variables.
EXPO_PUBLIC_OIDC_ISSUER=
EXPO_PUBLIC_OIDC_CLIENT_ID=
# Request only scopes WCSD registers for this public native client.
EXPO_PUBLIC_OIDC_SCOPES=openid profile email
