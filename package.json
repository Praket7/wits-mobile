{
  "name": "wits-mobile",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "packageManager": "pnpm@11.26.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app src scripts --max-warnings 0",
    "lint:expo": "expo lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "demo:server": "node scripts/demo-server.mjs",
    "smoke:http": "node scripts/smoke-http.mjs",
    "compare": "node scripts/build-compare.mjs",
    "shots": "node scripts/capture-screenshots.mjs",
    "shots:baseline": "node -e \"const fs=require('fs');fs.cpSync('docs/screenshots','docs/screenshots-baseline',{recursive:true});console.log('baseline updated')\"",
    "shots:diff": "node scripts/screenshot-diff.mjs",
    "contract": "node scripts/contract-check.mjs"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/src/test/setup.ts"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|decode-uri-component))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ]
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "5.102.8",
    "expo": "~57.0.24",
    "expo-constants": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.4",
    "test-renderer": "1.2",
    "typescript": "~6.0.3"
  },
  "private": true
}
