{
  "name": "wits-mobile-media",
  "version": "1.0.0",
  "description": "Short synthetic-data product tour for WITS Mobile",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.527",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.527",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.527",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "build": "remotion bundle",
    "render": "remotion render src/index.ts WitsMobileTour out/witsmobiletour.mp4 --codec=h264",
    "poster": "remotion still src/index.ts WitsMobileTour out/witsmobileposter.png --frame=45",
    "stats": "remotion still src/index.ts WitsMobileTour out/witsmobilestats.png --frame=470",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  },
  "sideEffects": false
}
